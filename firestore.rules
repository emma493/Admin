rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation schemas — match the REAL Session A/B contract
    // (shortxx-live default DB). Kept as documentation helpers; the open
    // match rules below stay permissive because the public static site
    // (no auth) must read videos + write views/likes/events directly.
    function isValidVideo(data) {
      return data.keys().hasAny(['direct_url', 'hls_url'])
        && (!('direct_url' in data) || (data.direct_url is string && data.direct_url.size() <= 2000))
        && (!('hls_url' in data) || (data.hls_url is string && data.hls_url.size() <= 2000))
        && (!('poster_url' in data) || (data.poster_url is string && data.poster_url.size() <= 2000))
        && (!('is_active' in data) || (data.is_active is bool))
        && (!('views' in data) || (data.views is number && data.views >= 0))
        && (!('likes' in data) || (data.likes is number && data.likes >= 0))
        && (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!('category' in data) || (data.category in ['girls', 'couples']))
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 300))
        && (!('hashtags' in data) || (data.hashtags is list))
        && (!('status' in data) || (data.status in ['processing', 'ready', 'failed']));
    }

    // Match Rules
    match /videos/{videoId} {
      allow read, write: if true;
    }

    match /creators/{creatorId} {
      allow read, write: if true;
    }

    match /ads/{adId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /events/{eventId} {
      allow read, write: if true;
    }

    match /daily_analytics/{dateId} {
      allow read, write: if true;
    }

    match /admin_analytics/{docId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
