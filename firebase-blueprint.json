{
  "entities": {
    "users": {
      "title": "User",
      "description": "Monitored user traffic and device information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "country": { "type": "string" },
        "deviceType": { "type": "string" },
        "trafficSource": { "type": "string" },
        "status": { "type": "string" },
        "totalDurationSeconds": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" },
        "firstSeen": { "type": "string", "format": "date-time" },
        "currentPage": { "type": "string" },
        "notificationsSubscribed": { "type": "boolean" },
        "totalDownloads": { "type": "number" }
      },
      "required": ["userId", "country", "deviceType", "trafficSource", "status", "totalDurationSeconds"]
    },
    "events": {
      "title": "Telemetry Event",
      "description": "User interaction, video telemetry, and app download events",
      "type": "object",
      "properties": {
        "event_type": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "user_agent": { "type": "string" },
        "device_type": { "type": "string" },
        "video_id": { "type": "string" },
        "referrer": { "type": "string" },
        "country": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["event_type", "userId", "device_type"]
    },
    "notifications": {
      "title": "Notification",
      "description": "Instant and scheduled notification templates",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["instant", "daily"] },
        "template": { "type": "string" },
        "namesList": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imageUrl": { "type": "string" },
        "targetUrl": { "type": "string" },
        "scheduleType": { "type": "string", "enum": ["fixed", "random"] },
        "intervalHours": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "template", "namesList", "status"]
    },
    "videos": {
      "title": "Video",
      "description": "Video stream links and analytics",
      "type": "object",
      "properties": {
        "page_url": { "type": "string" },
        "direct_url": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "views": { "type": "number" }
      },
      "required": ["direct_url", "is_active", "views"]
    },
    "daily_analytics": {
      "title": "Daily Analytics",
      "description": "Daily aggregated traffic analytics keyed by YYYY-MM-DD",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "uniqueVisitors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pageViews": { "type": "number" },
        "appInstalls": { "type": "number" },
        "hourlyTraffic": { "type": "object" },
        "trafficSources": { "type": "object" },
        "deviceTypes": { "type": "object" },
        "countries": { "type": "object" }
      },
      "required": ["date", "pageViews"]
    },
    "admin_analytics": {
      "title": "Admin Analytics",
      "description": "Global app installation tracking metrics",
      "type": "object",
      "properties": {
        "totalAppInstalls": { "type": "number" }
      },
      "required": ["totalAppInstalls"]
    }
  }
}
